<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121"
    android:padding="8dp">

    <!-- Top App Bar with Categories Dropdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Periodic Table"
            android:textColor="#fcfcfc"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Categories Button -->
        <Button
            android:id="@+id/btnShowCategories"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Categories"
            android:textSize="12sp"
            android:background="@drawable/categories_button_bg"
            android:textColor="#ffffff"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Sample Categories Hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:background="@drawable/rounded_legend_bg"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories: "
            android:textColor="#fcfcfc"
            android:textSize="12sp"/>

        <!-- Sample color indicators -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/rounded_alkali_metal_bg"
                android:layout_marginEnd="2dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/rounded_nonmetal_bg"
                android:layout_marginEnd="2dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/rounded_transition_bg"
                android:layout_marginEnd="2dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/rounded_noble_gas_bg"
                android:layout_marginEnd="2dp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/rounded_metalloid_bg"
                android:layout_marginEnd="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#fcfcfc"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Periodic Table Grid in ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:background="@drawable/rounded_table_bg">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <GridLayout
                android:id="@+id/periodicTableGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="18"
                android:rowCount="9"
                android:padding="8dp"
                android:useDefaultMargins="true" />

        </ScrollView>
    </HorizontalScrollView>
</LinearLayout> 