<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#212121"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/popup_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Element Name (Symbol)"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <TextView
        android:id="@+id/popup_atomic_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atomic Number: "
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/popup_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Row: "
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/popup_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Column: "
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/popup_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category: "
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:paddingBottom="24dp"/>

    <Button
        android:id="@+id/popup_close_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLOSE"
        android:backgroundTint="#E85D04"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="24dp"/>

</LinearLayout>
