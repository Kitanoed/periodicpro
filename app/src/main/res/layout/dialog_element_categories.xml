<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_dialog_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Element Categories"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <!-- Alkali Metals -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/alkali_metal"
            android:text="Alkali Metals"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Alkaline Earth Metals -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/alkaline_earth_metal"
            android:text="Alkaline Earth Metals"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Transition Metals -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/transition_metal"
            android:text="Transition Metals"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Post-Transition Metals -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/post_transition_metal"
            android:text="Post-Transition Metals"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Metalloids -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/metalloid"
            android:text="Metalloids"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Nonmetals -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/nonmetal"
            android:text="Nonmetals"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Halogens -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/halogen"
            android:text="Halogens"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Noble Gases -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/noble_gas"
            android:text="Noble Gases"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Lanthanides -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/lanthanide"
            android:text="Lanthanides"
            android:textColor="#000000"
            android:gravity="center"/>

        <!-- Actinides -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:padding="8dp"
            android:background="@drawable/rounded_category_bg"
            android:backgroundTint="@color/actinide"
            android:text="Actinides"
            android:textColor="#000000"
            android:gravity="center"/>
    </GridLayout>

    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Close"
        android:layout_marginTop="16dp"
        android:background="@drawable/categories_button_bg"
        android:textAllCaps="false"
        android:textColor="#ffffff"/>
</LinearLayout> 