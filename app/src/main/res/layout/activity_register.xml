<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121"
    android:gravity="center">

    <!-- Logo Placeholder -->
    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="20dp"/>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PeriodicPro"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Login Form Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="20dp"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="30dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp"
        android:background="@drawable/rounded_form_bg">

        <!-- Username Input -->
        <EditText
            android:id="@+id/edittext_usernameRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Username"
            android:textColorHint="#666666"
            android:textColor="#000000"
            android:padding="10dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/rounded_input_bg"
            android:textSize="16sp"
            tools:ignore="VisualLintTextFieldSize" />

        <!-- Password Input -->
        <EditText
            android:id="@+id/edittext_passwordRegister"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Password"
            android:textColorHint="#666666"
            android:textColor="#000000"
            android:padding="10dp"
            android:inputType="textPassword"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_input_bg"
            tools:ignore="VisualLintTextFieldSize" />

        <EditText
            android:id="@+id/edittext_confirmPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Confirm Password"
            android:textColorHint="#666666"
            android:textColor="#000000"
            android:padding="10dp"
            android:inputType="textPassword"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rounded_input_bg"
            tools:ignore="VisualLintTextFieldSize" />

        <!-- Login Button -->
        <Button
            android:id="@+id/button_goToLogin"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:text="Register"
            android:textColor="#000000"
            android:padding="10dp"
            android:textAllCaps="false"
            android:background="@drawable/rounded_button_bg"/>
    </LinearLayout>


</LinearLayout>
