<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PeriodicPro"
            android:textColor="#fcfcfc"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Welcome Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome to PeriodicPro"
        android:textColor="#fcfcfc"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your interactive periodic table companion"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#fcfcfc"
        android:layout_marginBottom="16dp"/>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/rounded_form_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Search Icon"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search elements..."
            android:textSize="14sp"
            android:background="@null"
            android:textColorHint="#9CA3AF"/>
    </LinearLayout>

    <!-- Buttons Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/button_pTable"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="90dp"
            android:background="@drawable/rounded_form_bg"
            android:text="Periodic Table"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fcfcfc"
            android:drawableTop="@drawable/ic_table"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/button_favorites"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="90dp"
            android:background="@drawable/rounded_form_bg"
            android:text="Favorites"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#fcfcfc"
            android:drawableTop="@drawable/ic_favorite"
            android:gravity="center"
            android:padding="12dp"/>
    </LinearLayout>


    <!-- Recent Elements Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent Elements"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#fcfcfc"
        android:layout_marginBottom="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/rounded_form_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hydrogen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/rounded_card_bg"
                android:gravity="center"
                android:text="H"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hydrogen"

                    android:textColor="#fcfcfc"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atomic number: 1"
                    android:textColor="#fcfcfc"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:background="@drawable/rounded_form_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/button_landing"
            android:layout_width="8dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_form_bg"
            android:drawableTop="@drawable/ic_home"
            android:padding="8dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/button_table"
            android:layout_width="8dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_form_bg"
            android:drawableTop="@drawable/ic_table"
            android:padding="8dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/button_profile"
            android:layout_width="8dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_form_bg"
            android:drawableTop="@drawable/ic_profile"
            android:padding="8dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/button_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_form_bg"
            android:drawableTop="@drawable/ic_settings"
            android:padding="8dp"
            android:stateListAnimator="@null" />

    </LinearLayout>
</LinearLayout>