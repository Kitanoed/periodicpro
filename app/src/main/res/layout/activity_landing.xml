<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#212121"
    android:padding="16dp">

    <!-- Welcome Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">
        
        <TextView
            android:id="@+id/text_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to PeriodicPro"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your interactive periodic table companion"
            android:textColor="#bbbbbb"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/rounded_table_bg"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginEnd="8dp"
            app:tint="#ffffff" />

        <AutoCompleteTextView
            android:id="@+id/edittext_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search elements..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="#ffffff"
            android:textColorHint="#999999"
            android:background="@android:color/transparent"
            android:textSize="16sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Navigation Buttons with improved design -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/button_pTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PERIODIC TABLE"
            android:background="@drawable/categories_button_bg"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <Button
            android:id="@+id/button_favorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FAVORITES"
            android:background="@drawable/categories_button_bg"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:paddingVertical="12dp"
            android:layout_marginStart="8dp"
            android:elevation="4dp" />
    </LinearLayout>

    <!-- Recent Elements Section with Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        
        <TextView
            android:id="@+id/text_recent_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recent Elements"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/text_view_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View All"
            android:textColor="#00796B"
            android:textSize="14sp"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Recent Elements List with card-like appearance -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />
        </ScrollView>
        
        <!-- Empty state message for no recent elements -->
        <TextView
            android:id="@+id/text_no_recent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No recent elements yet.\nTap on any element to see it here!"
            android:textColor="#999999"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Navigation placeholder -->
    <FrameLayout
        android:id="@+id/navigation_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
</LinearLayout>
