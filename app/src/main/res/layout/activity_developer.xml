<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_code"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developers"
                android:textColor="#fcfcfc"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Meet the Team Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meet the Team"
            android:textColor="#fcfcfc"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Team Introduction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We are a dedicated and enthusiastic team of student developers currently pursuing our Bachelor of Science in Information Technology. Hailing from section G6 of our second year, we are passionate about applying our growing knowledge to create impactful and engaging digital experiences."
            android:textColor="#d3d3d3"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <!-- Andrei Sam Loy Profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_form_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/profile2"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Andrei Sam Loy"
                android:textColor="#fcfcfc"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSIT - 2nd Year / G6\nLead Developer / Full Stack"
                android:textColor="#d3d3d3"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&quot;The best way to predict the future is to invent it.&quot; - Alan Kay"
                android:textColor="#fcfcfc"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:gravity="center_horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Role &amp; Experience:\nAs the Lead Developer, Andrei guides the technical direction of our projects with 2 years of full-stack experience. He is proficient in Java, Kotlin, and C."
                android:textColor="#d3d3d3"
                android:textSize="14sp"
                android:paddingTop="10dp" />
        </LinearLayout>

        <!-- Axcel Macansantos Profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_form_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/profile1"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Axcel Macansantos"
                android:textColor="#fcfcfc"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BSIT - 2nd Year / G6\nAssistant Developer / UI-UX Focus"
                android:textColor="#d3d3d3"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingTop="6dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&quot;It's not a bug, it's an undocumented feature.&quot; - Anonymous"
                android:textColor="#fcfcfc"
                android:textSize="14sp"
                android:paddingTop="10dp"
                android:gravity="center_horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Role &amp; Contribution:\nAxcel specializes in front-end development and ensures the app's UI/UX is intuitive and visually appealing. He has skills in Java, Kotlin, and C."
                android:textColor="#d3d3d3"
                android:textSize="14sp"
                android:paddingTop="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
