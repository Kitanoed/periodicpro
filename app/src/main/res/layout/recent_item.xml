<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/rounded_table_bg"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/recent_symbol"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="H"
        android:textStyle="bold"
        android:textColor="#000"
        android:background="@drawable/rounded_nonmetal_bg"
        android:textSize="16sp" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/recent_name"
            android:text="Hydrogen"
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/recent_number"
            android:text="Atomic number: 1"
            android:textSize="12sp"
            android:textColor="#cccccc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
